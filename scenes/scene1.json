      "onTap": { "action": "openWindow", "startDialogue": true }
    },
    {
      "id": "door",
      "image": "door",
      "box": { "x": 68, "y": 26, "w": 27, "h": 52 },
      "onTap": { "action": "locked", "lineKey": "narration.door", "badge": "lock" }
    },
    {
      "id": "bed",
      "image": "bed",
      "box": { "x": 3, "y": 58, "w": 58, "h": 30 },
      "onTap": { "action": "joke", "lineKey": "narration.bed" }
    }
  ],
