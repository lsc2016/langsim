          { "key": "me.reply.2", "next": "bad" },
          { "key": "me.reply.3", "next": "late" }
        ]
      },
      "good": {
        "speaker": "friend",
        "lineKey": "friend.good",
        "choices": [
          { "key": "me.good.1", "next": "walk" },
          { "key": "me.good.2", "next": "walk" },
          { "key": "me.good.3", "next": "walk" }
        ]
      },
      "bad": {
        "speaker": "friend",
        "lineKey": "friend.bad",
        "choices": [
          { "key": "me.bad.1", "next": "rest" },
          { "key": "me.bad.2", "next": "rest" },
          { "key": "me.bad.3", "next": "rest" }
        ]
      },
      "late": {
        "speaker": "friend",
        "lineKey": "friend.late",
        "choices": [
          { "key": "me.late.1", "next": "walk" },
          { "key": "me.late.2", "next": "walk" },
          { "key": "me.late.3", "next": "walk" }
        ]
      },
      "walk": {
        "speaker": "friend",
        "lineKey": "friend.walk",
        "choices": [
          { "key": "me.walk.1", "next": "bye" },
          { "key": "me.walk.2", "next": "bye" },
          { "key": "me.walk.3", "next": "bye" }
        ]
      },
      "rest": {
        "speaker": "friend",
        "lineKey": "friend.rest",
        "choices": [
          { "key": "me.rest.1", "next": "bye" },
          { "key": "me.rest.2", "next": "bye" },
          { "key": "me.rest.3", "next": "bye" }
